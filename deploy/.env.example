# --- required ---------------------------------------------------------------
KENYABIDDER_DOMAIN=kenyabidder.example.co.ke
KENYABIDDER_PUBLIC_URL=https://kenyabidder.example.co.ke
POSTGRES_PASSWORD=change-me-long-random
# One-time setup code needed to create the first admin account on a fresh install (on a production site with no accounts, the first administrator cannot be created without it).
KENYABIDDER_BOOTSTRAP_TOKEN=
# Strongly recommended below; production start-up validation refuses missing/insecure values.
# 32+ random chars; keep in your secret manager. Signs session cookies.
KENYABIDDER_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  Encrypts API keys / 2FA seeds at rest.
KENYABIDDER_ENCRYPTION_KEY=
KENYABIDDER_METRICS_TOKEN=
WHATSAPP_APP_SECRET=

# --- payments (M-Pesa Daraja) ----------------------------------------------
MPESA_ENV=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_BASE_URL=https://kenyabidder.example.co.ke

# --- messaging ---------------------------------------------------------------
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- WhatsApp Cloud API ------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- operations ----------------------------------------------------------------
KENYABIDDER_LOG_JSON=1
KENYABIDDER_BACKUP_KEEP=14
